{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.(html|js|css|json|ttf|woff2|txt))",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/version",
      "destination": "/version.json"
    },
    {
      "source": "/api/release-notes",
      "destination": "/version.json"
    },
    {
      "source": "/downloads/valenixia.apk",
      "destination": "/downloads/valenixia-pos.apk"
    },
    {
      "source": "/downloads/valenixia.exe",
      "destination": "/downloads/valenixia-pos.exe"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
