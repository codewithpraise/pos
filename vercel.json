{
  "version": 2,
  "alias": [
    "valenixia-pos.vercel.app"
  ],
  "outputDirectory": "public",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"valenixia-pos.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"valenixia-pos.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.exe",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.microsoft.portable-executable" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"valenixia-pos.exe\"" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.msi",
      "headers": [
        { "key": "Content-Type", "value": "application/x-msi" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"valenixia-pos.msi\"" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/claims/(.*)",
      "destination": "/api/claims"
    },
    {
      "source": "/api/devices/(.*)",
      "destination": "/api/devices"
    },
    {
      "source": "/api/version",
      "destination": "/version.json"
    },
    {
      "source": "/api/release-notes",
      "destination": "/version.json"
    },
    {
      "source": "/downloads/valenixia.apk",
      "destination": "/downloads/valenixia-pos.apk"
    },
    {
      "source": "/downloads/app-debug.apk",
      "destination": "/downloads/valenixia-pos.apk"
    },
    {
      "source": "/downloads/valenixia-pos-mobile.apk",
      "destination": "/downloads/valenixia-pos.apk"
    },
    {
      "source": "/downloads/valenixia-pos-latest.apk",
      "destination": "/downloads/valenixia-pos.apk"
    },
    {
      "source": "/downloads/valenixia.exe",
      "destination": "/downloads/valenixia-pos.exe"
    },
    {
      "source": "/downloads/valenixia-pos-desktop.exe",
      "destination": "/downloads/valenixia-pos.exe"
    },
    {
      "source": "/downloads/nexova-pos-setup.exe",
      "destination": "/downloads/valenixia-pos.exe"
    },
    {
      "source": "/downloads/valenixia-pos-setup.msi",
      "destination": "/downloads/valenixia-pos.msi"
    },
    {
      "source": "/downloads/nexova-pos-setup.msi",
      "destination": "/downloads/valenixia-pos.msi"
    },
    {
      "source": "/((?!api/|downloads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
